{
  "name": "crm-new",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": "24.12.0",
    "pnpm": "10.26.0"
  },
  "scripts": {
    "build": "nuxt build",
    "build:local-ocr-sdk": "vite build --config scripts/local-ocr-sdk.config.ts",
    "check:cycles": "dpdm",
    "check:deps": "node-modules-inspector report duplicates --depth 20",
    "check:links": "node scripts/check-md-links.mjs",
    "design:sync-coverage": "node scripts/sync-design-coverage.mjs",
    "design:sync-manifest": "node scripts/sync-design-token-manifest.mjs",
    "dev": "nuxt dev",
    "dev:lan": "nuxt dev --host 0.0.0.0",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:watch": "vitest --config vitest.browser.config.ts --project chromium-1280 --browser.headless=false",
    "test:components": "vitest run --project component",
    "test:e2e": "playwright test",
    "test:production": "node scripts/run-production-acceptance.mjs",
    "test:unit": "vitest run --project unit --project unit-heavy",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots=all",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.116",
    "@paddleocr/paddleocr-js": "0.4.2",
    "@pinia/nuxt": "^0.11.3",
    "@unocss/nuxt": "^66.7.5",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "nuxt": "^4.4.8",
    "pdfjs-dist": "^5.6.205",
    "reka-ui": "^2.10.1",
    "sql.js": "^1.14.1",
    "unocss": "^66.7.5",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.9",
    "vxe-pc-ui": "^4.16.1",
    "vxe-table": "^4.19.25",
    "xe-utils": "^4.0.11",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@nuxt/eslint": "^1.16.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/vue": "8.1.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/browser-playwright": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "dpdm": "4.3.0",
    "esbuild": "0.28.1",
    "eslint": "^10.6.0",
    "husky": "^9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "^17.0.8",
    "node-modules-inspector": "2.7.0",
    "vitest": "^4.1.10",
    "vitest-axe": "0.1.0",
    "vitest-browser-vue": "3.1.0",
    "vue-tsc": "^3.3.7"
  },
  "pnpm": {
    "overrides": {
      "@vitest/eslint-plugin": "1.6.28"
    },
    "patchedDependencies": {
      "node-modules-tools@2.7.0": "patches/node-modules-tools@2.7.0.patch"
    }
  }
}
