zero=0000000000000000000000000000000000000000
verify=0
seen_ref=0

while read -r local_ref local_sha remote_ref remote_sha; do
  seen_ref=1
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" "refs/remotes/$1/main" 2>/dev/null) || { verify=1; break; }
  else
    base=$remote_sha
  fi

  git diff --quiet --diff-filter=ACMRD "$base" "$local_sha" -- \
    '*.js' '*.jsx' '*.mjs' '*.cjs' '*.ts' '*.tsx' '*.mts' '*.cts' '*.vue' \
    '*.json' '*.jsonc' 'pnpm-lock.yaml' '.npmrc' 'pnpm-workspace.yaml' \
    '.husky/*' || { verify=1; break; }
done

# Direct invocation without push metadata remains a full local verification.
[ "$seen_ref" -eq 0 ] && verify=1
[ "$verify" -eq 0 ] && exit 0

pnpm typecheck || exit $?
npm test
